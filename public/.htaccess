# eDrive Water Sports Next.js production rules
RewriteEngine On

# Send non-HTTPS or non-canonical hosts directly to the canonical URL.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^edrivedubai\.ae$ [NC]
RewriteRule ^ https://edrivedubai.ae%{REQUEST_URI} [R=301,L,NE]

# Protect environment and repository files if they are ever uploaded accidentally.
<FilesMatch "^(\.env|\.git|package(-lock)?\.json|tsconfig\.json)$">
  Require all denied
</FilesMatch>

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/_next/static/" edrive_versioned_asset=1
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml application/manifest+json
</IfModule>

<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml application/manifest+json
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  # Always revalidate HTML after a deployment.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Only hashed Next.js assets receive long immutable caching.
  Header set Cache-Control "public, max-age=31536000, immutable" env=edrive_versioned_asset

  # The service worker must always be checked for updates.
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Service-Worker-Allowed "/"
  </Files>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
